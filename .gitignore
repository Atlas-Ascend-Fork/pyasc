# Please keep this project-level .gitignore minimal. Add only broadly applicable
# generated, build, cache, or tool-output patterns. Put contributor-local or
# one-off excludes in .git/info/exclude file.

# IDE configuration
.vscode/
.idea/

# AI agents
.agents/
.claude/
.spec-workflow/
AGENTS.md
CLAUDE.md
docs/superpowers/
skills-lock.json

# Build cache
/build*/
__pycache__/
dist/
wheels/
*.egg-info/
*.py[codz]
*.so
*.o

# Other
oat_reports/
.venv*/
venv*/
pythonenv*/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.info
*.log
.coverage
.lit_test_times.txt

# /docs
/docs/_build/
/docs/python-api/rst/**/generated/

# /python
/python/asc/_C/libpyasc/*
!/python/asc/_C/libpyasc/py.typed

# /test
/test/**/Output/
/test/build
